{
  "name": "singit-agent-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Agents that pay each other: MCP server with programmable USDC mandates, escrow holds and human-approved disputes (FinTechers Prague hackathon, Track 2)",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "npm --prefix singit-mcp ci --no-audit --no-fund",
    "demo:all": "bash singit-mcp/scripts/demo-all.sh",
    "live:all": "bash singit-mcp/scripts/live-all.sh",
    "demo": "npm --prefix singit-mcp run demo",
    "bedrock:install": "npm --prefix examples/bedrock-buyer ci --ignore-scripts --no-audit --no-fund",
    "bedrock:mock": "node examples/bedrock-buyer/mock-bedrock.mjs",
    "bedrock:buyer": "node examples/bedrock-buyer/bedrock-buyer.mjs",
    "test:bedrock": "npm --prefix examples/bedrock-buyer test",
    "test": "npm --prefix singit-mcp test && npm --prefix demo-dashboard run test:e2e",
    "test:mcp": "npm --prefix singit-mcp test",
    "e2e:mcp": "npm --prefix singit-mcp run e2e:mcp",
    "test:dashboard": "npm --prefix demo-dashboard run test:e2e",
    "typecheck": "npm --prefix singit-mcp run typecheck",
    "start:http": "npm --prefix singit-mcp run start:http",
    "approve": "npm --prefix singit-mcp run approve --",
    "inspect:state": "npm --prefix singit-mcp run inspect:state --",
    "review:legacy": "npm --prefix singit-mcp run review:legacy --"
  }
}
