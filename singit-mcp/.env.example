# Trusted local devnet demo only. Do not put secrets or key bytes in this file.
SINGIT_BACKEND=capture402
# REQUIRED: explicitly approved HTTPS Helius or QuickNode endpoint. No public fallback.
SINGIT_RPC_URL=
# REQUIRED: independently verified deployment, never a source fixture ID or deployer address.
# Partner-confirmed hackathon devnet deployment (public values, see docs/CAPTURE402-DEVNET.md).
# Provenance: 992Qmwmw... is ALSO a test fixture in capture402-solana ops/test_reconcile_wire.py; partner confirmation is what makes it the deployment.
SINGIT_PROGRAM_ID=992QmwmwCebawRJsTCgvc8qnzGivbFaD39ZQE7VhHp7o
SINGIT_PROGRAM_DATA=HTKbRudHxuqgQvqpfrUM59ZohVfbx81Yu8Bdyp897doM
# SHA256 of ProgramData bytes after offset 45, INCLUDING executable allocation padding.
SINGIT_EXECUTABLE_SHA256=adee4e8f51fbc52b046c4d5a846c63ecdb63d392b1d16b559d3f6c2984b27415
SINGIT_DEPLOYMENT_SLOT=508146249
# Pin the accepted upgrade authority for a merchant verification window, or "none" for immutable.
# SINGIT_UPGRADE_AUTHORITY=
# Separate throwaway Solana JSON keypair files OUTSIDE every Git checkout (mode 600).
SINGIT_PAYER_KEYPAIR=
SINGIT_MERCHANT_KEYPAIR=
# Public keys of those throwaway wallets. STILL NEEDED from partner/team; fill only in your local, uncommitted env file.
SINGIT_PAYER_ADDRESS=
SINGIT_MERCHANT_ADDRESS=
# Required for live MCP startup: private durable state outside all Git checkouts.
SINGIT_STATE_DIR=
# Generate each once, retain in the private env file, and keep out of agent config.
SINGIT_HUMAN_APPROVAL_SECRET=
SINGIT_HUMAN_ROUTE_SECRET=
# Agent bearer tokens (>=16 chars, distinct from each other and from the human secrets).
# The buyer and merchant agents each get only their own token; live:all then runs without trusted-operator mode.
SINGIT_BUYER_TOKEN=
SINGIT_MERCHANT_TOKEN=
# Optional host-wide directory for the one-runtime-per-wallets lock (default ~/.singit-mcp/locks).
SINGIT_NAMESPACE_LOCK_DIR=
# Existing private mode-700 directory OUTSIDE checkout for original signed wires and receipts.
SINGIT_EVIDENCE_DIR=
# Set to 1 only after separate explicit authorization for live signing/sending.
SINGIT_CONTRACT_DEVNET=0
SINGIT_CONTRACT_UNIT=100000
