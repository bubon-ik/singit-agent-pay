# ~/apps/hackathon/hackathon.env  (chmod 600). Hackathon / Solana devnet ONLY.
# Never copy anything from any production env file. systemd does not strip inline comments: keep comments on their own lines.
# mock until the teammate's Capture402Backend is wired, then capture402
SINGIT_BACKEND=mock
# The capture402 backend requires an approved HTTPS Helius or QuickNode endpoint. Public devnet RPC is acceptable only while SINGIT_BACKEND=mock.
SINGIT_RPC_URL=https://api.devnet.solana.com
# capture402 needs an approved Helius/QuickNode HTTPS RPC; it refuses public RPC. RPC choice still to confirm with the partner.
# Partner-confirmed hackathon devnet deployment (public values, see docs/CAPTURE402-DEVNET.md).
# Provenance: 992Qmwmw... is ALSO a test fixture in capture402-solana ops/test_reconcile_wire.py; partner confirmation is what makes it the deployment.
SINGIT_PROGRAM_ID=992QmwmwCebawRJsTCgvc8qnzGivbFaD39ZQE7VhHp7o
SINGIT_PROGRAM_DATA=HTKbRudHxuqgQvqpfrUM59ZohVfbx81Yu8Bdyp897doM
# SHA256 of ProgramData bytes after offset 45, including allocation padding
SINGIT_EXECUTABLE_SHA256=adee4e8f51fbc52b046c4d5a846c63ecdb63d392b1d16b559d3f6c2984b27415
SINGIT_DEPLOYMENT_SLOT=508146249
# Keys: devnet throwaway keypairs generated locally by the team, loaded from env (SINGIT_PAYER_KEYPAIR / SINGIT_MERCHANT_KEYPAIR),
# never committed; agents never see keys. Values are file paths. Never mainnet.
SINGIT_MERCHANT_KEYPAIR=
SINGIT_PAYER_KEYPAIR=
# public keys matching the keypairs (used by npm run devnet:smoke and the gated devnet contract test)
# STILL NEEDED from partner/team; set only in the real env file on the host, never commit.
SINGIT_PAYER_ADDRESS=
SINGIT_MERCHANT_ADDRESS=
# Existing private mode-700 directory outside the checkout for signed wires and receipts.
SINGIT_EVIDENCE_DIR=
# generate once on the VPS: openssl rand -hex 32
SINGIT_HUMAN_APPROVAL_SECRET=
SINGIT_HUMAN_ROUTE_SECRET=
SINGIT_RATE_LIMIT_PER_MIN=60
