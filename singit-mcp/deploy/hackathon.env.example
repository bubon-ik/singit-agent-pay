# ~/apps/hackathon/hackathon.env  (chmod 600). Hackathon / Solana devnet ONLY.
# Never copy anything from any production env file. systemd does not strip inline comments: keep comments on their own lines.
# mock until the teammate's Capture402Backend is wired, then capture402
SINGIT_BACKEND=mock
SINGIT_RPC_URL=https://api.devnet.solana.com
# devnet capture402 program id: TO CONFIRM WITH TEAMMATE. Not committed in capture402-solana @ 236b09a
# (loaded at runtime from its deployment record; repo ids are test fixtures only, see INTERFACE.md).
SINGIT_PROGRAM_ID=
# Keys: devnet throwaway keypairs generated locally by the team, loaded from env (SINGIT_PAYER_KEYPAIR / SINGIT_MERCHANT_KEYPAIR),
# never committed; agents never see keys. Values are file paths. Never mainnet.
SINGIT_MERCHANT_KEYPAIR=
SINGIT_PAYER_KEYPAIR=
# public keys matching the keypairs (used by npm run devnet:smoke and the gated devnet contract test)
SINGIT_PAYER_ADDRESS=
SINGIT_MERCHANT_ADDRESS=
# generate once on the VPS: openssl rand -hex 32
SINGIT_HUMAN_APPROVAL_SECRET=
SINGIT_RATE_LIMIT_PER_MIN=60
