{
  "name": "singit-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for agent-to-agent stablecoin payments with programmable mandates (FinTechers hackathon)",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "bin": {
    "singit-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts --http",
    "test": "vitest run",
    "test:recovery:offline": "vitest run test/recovery.offline.test.ts test/review-regressions.test.ts test/accounting.atomic.test.ts test/journal-safety.test.ts test/store-io.test.ts test/inspection.test.ts test/runtime.test.ts test/service.hardening.test.ts test/safety.mcp.test.ts test/capture402.test.ts test/backend-contract.mock.test.ts",
    "e2e:mcp": "vitest run test/e2e.mcp",
    "demo": "tsx scripts/demo.ts",
    "approve": "tsx scripts/approve.ts",
    "devnet:smoke": "tsx scripts/devnet-smoke.ts",
    "demo:all": "bash scripts/demo-all.sh",
    "live:all": "bash scripts/live-all.sh",
    "inspect:state": "TSX_DISABLE_CACHE=1 node --import tsx scripts/inspect-state.ts",
    "review:legacy": "TSX_DISABLE_CACHE=1 node --import tsx scripts/review-legacy.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
